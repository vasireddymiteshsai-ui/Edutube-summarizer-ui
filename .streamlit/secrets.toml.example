# EduTube Summarizer Secrets Configuration
# ==========================================
# 
# This file contains sensitive configuration variables for Streamlit Cloud deployment.
# 
# IMPORTANT SECURITY NOTES:
# ========================
# 1. NEVER commit this file to GitHub (it's in .gitignore)
# 2. Only store secrets in Streamlit Cloud's Secrets Manager
# 3. Never hardcode passwords, API keys, or sensitive data in code
# 
# HOW TO USE SECRETS IN STREAMLIT CLOUD:
# =======================================
# 1. Go to your app on Streamlit Cloud (https://share.streamlit.io)
# 2. Click the three dots (⋯) → "Settings"
# 3. Click "Secrets" tab
# 4. Paste the content below (without this header)
# 5. Update with your actual values
# 6. Save
# 7. Streamlit will automatically restart and load secrets
# 
# ACCESS IN CODE:
# ===============
# import streamlit as st
# secret_value = st.secrets["SECRET_NAME"]
# 
# ═══════════════════════════════════════════════════════════════════════════════

# DATABASE CONFIGURATION
# ==========================================
# If migrating from SQLite to PostgreSQL (recommended for production):

# DATABASE_URL = "postgresql://username:password@host:5432/edutube_db"
# 
# Usage in code:
#   db_url = st.secrets.get("DATABASE_URL", "sqlite:///edutube.db")

# SECRET KEY FOR SESSION MANAGEMENT
# ==========================================
# Change this to a random string for enhanced security
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"

# SECRET_KEY = "your-super-secret-key-here-min-32-chars-long"

# EMAIL CONFIGURATION (Optional - for future notifications)
# ==========================================
# If you want to add email notifications for user signup confirmations:

# SMTP_SERVER = "smtp.gmail.com"
# SMTP_PORT = 587
# SMTP_EMAIL = "your-email@gmail.com"
# SMTP_PASSWORD = "your-app-specific-password"
# 
# Note: For Gmail, use an App Password (not your regular password)
# See: https://support.google.com/accounts/answer/185833

# API KEYS (Optional - for future integrations)
# ==========================================
# If you plan to integrate with external APIs:

# OPENAI_API_KEY = "sk-..."           # For AI-powered summarization
# YOUTUBE_API_KEY = "your-key-here"   # For YouTube transcript fetching
# HUGGINGFACE_API_KEY = "hf_..."      # For ML models

# SECURITY & AUTHENTICATION
# ==========================================
# Additional security settings:

# AUTH_TOKEN = "unique-token-for-admin-access"
# PASSWORD_MIN_LENGTH = 8
# MAX_LOGIN_ATTEMPTS = 5

# LOGGING & MONITORING (Optional)
# ==========================================
# If integrating with services like Sentry for error tracking:

# SENTRY_DSN = "https://key@sentry.io/project-id"

# EMAIL TEMPLATES (Optional)
# ==========================================
# For future email notifications:

# WELCOME_EMAIL_SUBJECT = "Welcome to EduTube Summarizer!"
# PASSWORD_RESET_EMAIL_SUBJECT = "Reset Your EduTube Password"

# ═══════════════════════════════════════════════════════════════════════════════
# 
# PRODUCTION CHECKLIST:
# ✓ Generated SECRET_KEY with secure random string
# ✓ Changed all default/example values
# ✓ Added DATABASE_URL if using PostgreSQL
# ✓ Email credentials if sending notifications
# ✓ API keys for any external services
# ✓ Verified secrets are in .gitignore
# ✓ Tested locally with python-dotenv before uploading to cloud
# 
# ═══════════════════════════════════════════════════════════════════════════════
